
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EVEREST STORE | المتجر الرسمي</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f7f7f7;color:#171717}
header{background:#101010;color:white;padding:20px 6%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px}
.logo{font-size:25px;font-weight:900;letter-spacing:2px}
header a{color:white;text-decoration:none;margin:0 8px}
.hero{background:#171717;color:white;text-align:center;padding:65px 15px}
.hero h1{font-size:38px;margin-bottom:15px}
.hero p{color:#ccc;margin-bottom:24px}
.btn{background:#fff;color:#111;border:0;padding:13px 23px;border-radius:6px;font-weight:bold;cursor:pointer;text-decoration:none;display:inline-block}
main{max-width:1100px;margin:auto;padding:35px 18px}
.section-title{text-align:center;margin-bottom:25px;font-size:27px}
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:20px}
.product{background:white;border-radius:12px;overflow:hidden;box-shadow:0 3px 14px #00000012}
.product img{width:100%;height:210px;object-fit:cover}
.product-info{padding:15px}
.product h3{margin-bottom:10px}
.price{font-size:19px;font-weight:bold;margin:12px 0;color:#111}
.add{width:100%;padding:12px;background:#111;color:white;border:0;border-radius:6px;cursor:pointer}
.cart{background:white;border-radius:12px;padding:20px;margin-top:35px}
.cart-item{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid #eee}
.cart button{cursor:pointer}
.remove{background:#eee;border:0;padding:7px;border-radius:5px}
.total{font-size:21px;font-weight:bold;margin:20px 0}
.checkout{background:#168b49;color:white;border:0;padding:14px;width:100%;border-radius:7px;font-size:16px;cursor:pointer}
input{width:100%;padding:13px;margin:8px 0;border:1px solid #ddd;border-radius:6px;font-size:15px}
footer{background:#111;color:white;text-align:center;padding:30px 15px;margin-top:35px}
footer p{margin:8px}
.small{font-size:13px;color:#777;margin-top:12px}
@media(max-width:600px){
.hero h1{font-size:29px}
header{justify-content:center}
}
</style>
</head>
<body>

<header>
  <div class="logo">EVEREST STORE</div>
  <nav>
    <a href="#home">الرئيسية</a>
    <a href="#products">المنتجات</a>
    <a href="#cart">السلة</a>
  </nav>
</header>

<section class="hero" id="home">
  <h1>مرحبا بك في EVEREST STORE</h1>
  <p>أناقتك تبدأ من هنا. اكتشف منتجاتنا الجديدة.</p>
  <a href="#products" class="btn">اكتشف المنتجات</a>
</section>

<main>
  <section id="products">
    <h2 class="section-title">منتجاتنا</h2>
    <div class="products" id="productList"></div>
  </section>

  <section class="cart" id="cart">
    <h2>🛒 سلة المشتريات</h2>
    <div id="cartItems">السلة فارغة حاليا.</div>
    <div class="total">المجموع: <span id="total">0</span> DH</div>

    <h3>معلومات الطلب</h3>
    <input id="customer" placeholder="الاسم الكامل">
    <input id="phone" type="tel" placeholder="رقم هاتف الزبون">
    <input id="address" placeholder="عنوان التوصيل والمدينة">
    <button class="checkout" onclick="sendOrder()">
      تأكيد الطلب عبر WhatsApp
    </button>
    <p class="small">سيتم إرسال تفاصيل طلبك إلى المتجر عبر WhatsApp.</p>
  </section>
</main>

<footer>
  <h2>EVEREST STORE</h2>
  <p>Your Style. Your Choice.</p>
  <p>للتواصل: 0751493644</p>
  <p>© 2026 EVEREST STORE</p>
</footer>

<script>
const products = [
  {
    id:1,
    name:"طاقية عصرية",
    price:79,
    image:"https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=600"
  },
  {
    id:2,
    name:"حقيبة ظهر",
    price:149,
    image:"https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600"
  },
  {
    id:3,
    name:"نظارات عصرية",
    price:89,
    image:"https://images.unsplash.com/photo-1511499767150-a48a237f0083?w=600"
  },
  {
    id:4,
    name:"ساعة أنيقة",
    price:199,
    image:"https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600"
  }
];

let cart = [];

function showProducts(){
  document.getElementById("productList").innerHTML =
  products.map(p => `
    <article class="product">
      <img src="${p.image}" alt="${p.name}">
      <div class="product-info">
        <h3>${p.name}</h3>
        <div class="price">${p.price} DH</div>
        <button class="add" onclick="addToCart(${p.id})">
          أضف إلى السلة
        </button>
      </div>
    </article>
  `).join("");
}

function addToCart(id){
  const item = cart.find(p => p.id === id);
  if(item){item.qty++;}
  else{
    const product = products.find(p => p.id === id);
    cart.push({...product,qty:1});
  }
  showCart();
}

function changeQty(id,change){
  const item=cart.find(p=>p.id===id);
  if(!item)return;
  item.qty+=change;
  if(item.qty<=0)cart=cart.filter(p=>p.id!==id);
  showCart();
}

function showCart(){
  const box=document.getElementById("cartItems");
  if(cart.length===0){
    box.innerHTML="السلة فارغة حاليا.";
  }else{
    box.innerHTML=cart.map(p=>`
      <div class="cart-item">
        <div>
          <b>${p.name}</b><br>
          ${p.price} DH × ${p.qty}
        </div>
        <div>
          <button class="remove" onclick="changeQty(${p.id},-1)">−</button>
          ${p.qty}
          <button class="remove" onclick="changeQty(${p.id},1)">+</button>
        </div>
      </div>
    `).join("");
  }
  document.getElementById("total").textContent=
    cart.reduce((sum,p)=>sum+p.price*p.qty,0);
}

function sendOrder(){
  if(cart.length===0){
    alert("السلة فارغة! أضف منتجا أولا.");
    return;
  }

  const name=document.getElementById("customer").value.trim();
  const phone=document.getElementById("phone").value.trim();
  const address=document.getElementById("address").value.trim();

  if(!name||!phone||!address){
    alert("المرجو ملء جميع معلومات الطلب.");
    return;
  }

  let message="طلب جديد من EVEREST STORE\n\n";
  message+="الاسم: "+name+"\n";
  message+="هاتف الزبون: "+phone+"\n";
  message+="العنوان: "+address+"\n\n";
  message+="المنتجات:\n";

  cart.forEach(p=>{
    message+=p.name+" × "+p.qty+" = "+(p.price*p.qty)+" DH\n";
  });

  const total=cart.reduce((sum,p)=>sum+p.price*p.qty,0);
  message+="\nالمجموع: "+total+" DH\n";
  message+="الدفع: عند الاستلام";

  const storeNumber="212751493644";
  const url="https://wa.me/"+storeNumber+"?text="+encodeURIComponent(message);
  window.open(url,"_blank");
}

showProducts();
showCart();
</script>

</body>
</html>
